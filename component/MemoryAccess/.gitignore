# Ignore whole work directory
work/*

# Except work/system.asn
!work/system.asn

# Ignore qt creator cache directory
.qtc_clangd

# Ignore qt creator user files
*.pro.user*

# Ignore aadl files
*.aadl

# Except MEMORYACCESS source files
!work/memoryaccess
work/memoryaccess/*
!work/memoryaccess/C
work/memoryaccess/C/*
!work/memoryaccess/C/src
work/memoryaccess/C/src/*
!work/memoryaccess/C/src/memoryaccess.c
!work/memoryaccess/C/src/flashd.c
!work/memoryaccess/C/src/flashd.h
!work/memoryaccess/C/src/efc.h
!work/memoryaccess/C/src/efc.c
!work/memoryaccess/C/src/component_efc.h
!work/memoryaccess/C/src/flash.h
